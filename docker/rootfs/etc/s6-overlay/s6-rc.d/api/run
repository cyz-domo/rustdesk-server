#!/command/with-contenv sh
sleep 3
cd /app
# rollback-journal + a multi-connection pool deadlocks the heartbeat writers under load;
# on a fresh deploy this creates the empty db already in WAL mode before apimain opens it
if command -v sqlite3 >/dev/null 2>&1; then
  sqlite3 data/rustdeskapi.db 'PRAGMA journal_mode=WAL;' >/dev/null
fi
./apimain
